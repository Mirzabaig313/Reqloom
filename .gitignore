/Qt/
*.user
*.user.*
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# ─── Conan (unused but silenced if accidentally initialised) ──────────────────
.conan/
conan.lock

# ─── Clang tooling caches ─────────────────────────────────────────────────────
.cache/
.clangd/

# ─── Coverage artefacts ───────────────────────────────────────────────────────
*.gcno
*.gcda
*.profraw
*.profdata
coverage/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Local development notes (private, per-author) ────────────────────────────
doc/local/
doc/adr/
tools/reqloom-smoke.sh
tools/reqloom-full-flow.sh
tools/reqloom-onboarding-flow.sh

